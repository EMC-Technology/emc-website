# SurrealDB 配置
# ⚠️ 生产环境必须修改！启动时若检测到占位符将拒绝运行。
SURREALDB_PASSWORD=<YOUR_SECURE_DB_PASSWORD_HERE>

# JWT 密钥（生产环境请使用至少 32 字节的随机密钥，推荐 Base64 编码）
# 生成方式: openssl rand -base64 32
# ⚠️ 生产环境必须修改！启动时若检测到占位符将拒绝运行。
JWT_SECRET=<YOUR_SECURE_JWT_SECRET_HERE>

# Grafana 管理员密码
# ⚠️ 生产环境必须修改！启动时若检测到占位符将拒绝运行。
GRAFANA_ADMIN_PASSWORD=<YOUR_SECURE_GRAFANA_PASSWORD_HERE>
